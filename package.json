{
  "name": "@metria/software",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "web:run:dev:spa": "nuxi dev src-nuxt --dotenv .env.development --port=1470",
    "web:run:prod:spa": "nuxi dev src-nuxt --dotenv .env.production --port=1470",
    "web:build:static:dev": "nuxi generate src-nuxt --dotenv .env.development",
    "web:build:static:prod": "nuxi generate src-nuxt --dotenv .env.production",
    "web:analyze": "nuxi analyze src-nuxt --loglevel verbose",
    "web:cleanup": "nuxi cleanup src-nuxt",
    "web:prepare": "nuxi prepare src-nuxt",
    "desktop:run:dev": "cross-env RUST_BACKTRACE=full tauri dev",
    "desktop:check:compile": "cd src-tauri && cargo check",
    "desktop:build:windows:x64": "tauri build --target x86_64-pc-windows-msvc",
    "desktop:build:windows:arm64": "tauri build --target aarch64-pc-windows-msvc",
    "desktop:build:macos:arm64": "tauri build --target aarch64-apple-darwin",
    "desktop:build:macos:x86_64": "tauri build --target x86_64-apple-darwin",
    "desktop:build:macos:universal": "tauri build --target universal-apple-darwin",
    "desktop:install:target:windows": "rustup target add x86_64-pc-windows-msvc && rustup target add aarch64-pc-windows-msvc",
    "desktop:install:target:macos": "rustup target add aarch64-apple-darwin && rustup target add x86_64-apple-darwin",
    "test:unit:dev": "vitest run --mode development",
    "test:unit:dev:watch": "vitest watch --mode development",
    "test:unit:dev:gui": "vitest --ui --mode development",
    "tauri": "tauri",
    "lint": "npm run lint:prettier && npm run lint:ts && npm run lint:eslint",
    "lint:prettier": "prettier --check .",
    "lint:ts": "nuxi typecheck src-nuxt --dotenv .env.development",
    "lint:eslint": "eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "prepare": "husky && nuxi prepare src-nuxt --dotenv .env.development"
  },
  "dependencies": {
    "@nuxt/ui": "^4.10.0",
    "@pinia/nuxt": "^0.11.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-http": "^2.5.9",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "pinia": "^3.0.4",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@nuxt/devtools": "^3.4.1",
    "@nuxtjs/google-fonts": "^3.2.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-jsdoc": "^63.3.3",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-vue": "^10.10.0",
    "husky": "^9.1.7",
    "npm-check-updates": "^22.2.3",
    "nuxt": "4.5.2",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sass": "^1.102.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.11",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.9"
  },
  "engines": {
    "node": ">=24.17.0"
  },
  "imports": {
    "#src-core/*": "./src-core/*",
    "#src-nuxt/*": "./src-nuxt/*"
  }
}
